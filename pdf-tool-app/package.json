{
  "name": "pdf-tool-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/@embedpdf/pdfium/dist/pdfium.wasm','public/pdfium.wasm')\"",
    "predev": "npm run copy-wasm",
    "prebuild": "npm run copy-wasm",
    "test": "tsx scripts/test-workspace-files.ts && tsx scripts/test-editor-session.ts && tsx scripts/test-no-mutation.ts"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "clsx": "^2.1.1",
    "next": "16.2.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.5.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
