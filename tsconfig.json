{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./pdf-tool-app/src/*"]
    }
  },
  "include": [
    "pdf-tool-app/next-env.d.ts",
    "pdf-tool-app/**/*.ts",
    "pdf-tool-app/**/*.tsx"
  ],
  "exclude": [
    "pdf-tool-app/node_modules",
    "**/node_modules",
    "pdf-tool-app/.next",
    "pdf-tool-app/.next-prod"
  ]
}
